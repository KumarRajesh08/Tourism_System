<style>
  .gpay-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(17, 24, 39, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .gpay-card {
    background: #ffffff;
    padding: 40px;
    border-radius: 24px;
    text-align: center;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transform: scale(0.9);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    max-width: 400px;
    width: 90%;
  }

  .gpay-overlay.active {
    display: flex;
    opacity: 1;
  }

  .gpay-overlay.active .gpay-card {
    transform: scale(1);
  }

  /* GPay Success Circle Animation */
  .success-checkmark {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
  }

  .check-icon {
    width: 80px;
    height: 80px;
    position: relative;
    border-radius: 50%;
    box-sizing: content-box;
    border: 4px solid #4CAF50;
  }

  .check-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 0;
    height: 0;
    background: #4CAF50;
    border-radius: 50%;
    transition: width 0.4s ease, height 0.4s ease;
    z-index: -1;
  }

  .gpay-overlay.active .check-icon::after {
    width: 100%;
    height: 100%;
  }

  .icon-line {
    height: 5px;
    background-color: #ffffff;
    display: block;
    border-radius: 2px;
    position: absolute;
    z-index: 10;
    opacity: 0;
  }

  .line-tip {
    width: 25px;
    left: 14px;
    top: 46px;
    transform: rotate(45deg);
  }

  .line-long {
    width: 47px;
    right: 8px;
    top: 38px;
    transform: rotate(-45deg);
  }

  .gpay-overlay.active .icon-line {
    opacity: 1;
    transition: all 0.2s 0.4s ease;
  }

  .gpay-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #111827;
    margin-bottom: 8px;
  }

  .gpay-message {
    color: #4b5563;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .gpay-btn {
    background: #111827;
    color: white;
    padding: 12px 32px;
    border-radius: 12px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .gpay-btn:hover {
    background: #1f2937;
  }

</style>

<div id="gPaySuccessOverlay" class="gpay-overlay">
  <div class="gpay-card">
    <div class="success-checkmark">
      <div class="check-icon">
        <span class="icon-line line-tip"></span>
        <span class="icon-line line-long"></span>
      </div>
    </div>
    <h2 class="gpay-title">Room Booked!</h2>
    <p id="gPayMessageContent" class="gpay-message">Your reservation has been confirmed. A confirmation report has been sent to your email.</p>
    <button class="gpay-btn" onclick="closeGPayPopup()">Awesome!</button>
  </div>
</div>

<script>
  function closeGPayPopup() {
    const overlay = document.getElementById('gPaySuccessOverlay');
    overlay.classList.remove('active');
    setTimeout(() => {
      overlay.style.display = 'none';
    }, 400);
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (window.showReservationSuccess) {
      const overlay = document.getElementById('gPaySuccessOverlay');
      const msgContent = document.getElementById('gPayMessageContent');
      
      if (window.reservationSuccessMsg) {
        msgContent.innerText = window.reservationSuccessMsg;
      }
      
      overlay.style.display = 'flex';
      setTimeout(() => {
        overlay.classList.add('active');
      }, 10);

      // Auto close after 5 seconds if not closed manually
      setTimeout(() => {
        closeGPayPopup();
      }, 6000);
    }
  });
</script>
