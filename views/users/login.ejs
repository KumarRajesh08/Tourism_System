<% layout("/layouts/boilerplate") %>

    <body>
        <div class="container mt-3">
            <div class="row justify-content-center">
                <div class="login-signup-form-inp">
                    <h3 class="mb-3">Login on Tourism_System</h3>
                    <form action="/login" method="post" novalidate class="needs-validation">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" class="form-control" name="username" id="username"
                                placeholder="e.g. sunny123" pattern="^(?=.*[0-9])[a-zA-Z0-9_]{3,30}$" required>
                            <div class="invalid-feedback">Username must be 3-30 characters and contain at least one number.</div>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" name="password" id="password"
                                placeholder="e.g. password123" required>
                            <div class="invalid-feedback">Please enter your password.</div>
                        </div>
                        <button class="btn btn-success">Login</button>
                    </form>
                </div>
            </div>
        </div>
    </body>