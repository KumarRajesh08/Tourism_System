<% layout("/layouts/boilerplate") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --accent: #1D9E75;
    --accent-dark: #0F6E56;
    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;
    --bg: #f9fafb;
    --card: #ffffff;
    --danger: #ef4444;
  }

  body { background: var(--bg); }

  /* ── Hero Image ── */
  .show-hero {
    position: relative;
    width: 100%;
    height: 420px;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  }
  .show-hero img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .show-hero:hover img { transform: scale(1.03); }
  .hero-badge {
    position: absolute;
    top: 18px; left: 18px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(8px);
    border-radius: 50px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-dark);
    border: 1px solid rgba(29,158,117,0.25);
  }
  .hero-price {
    position: absolute;
    bottom: 18px; right: 18px;
    background: rgba(17,24,39,0.82);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    padding: 10px 20px;
    color: #fff;
  }
  .hero-price .amount {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
  }
  .hero-price .per {
    font-size: 12px;
    color: rgba(255,255,255,0.7);
    display: block;
    margin-top: -2px;
  }

  /* ── Title & Meta ── */
  .listing-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.3rem;
  }
  .listing-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-bottom: 1.8rem;
  }
  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .meta-item i { color: var(--accent); font-size: 15px; }
  .meta-item b { color: var(--text); }

  /* ── Description Card ── */
  .info-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .info-card h5 {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.6rem;
  }
  .info-card p {
    font-size: 14px;
    color: #374151;
    line-height: 1.75;
    margin: 0;
  }

  /* ── Action Buttons ── */
  .action-strip {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .btn-reserve {
    flex: 1;
    min-width: 160px;
    padding: 13px 24px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-reserve:hover { background: var(--accent-dark); }
  .btn-reserve:active { transform: scale(0.98); }
  .btn-edit {
    padding: 13px 20px;
    background: #fff;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    text-decoration: none;
    display: flex; align-items: center; gap: 7px;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-edit:hover { border-color: #9ca3af; background: var(--bg); color: var(--text); }
  .btn-delete {
    padding: 13px 20px;
    background: #fff;
    color: var(--danger);
    border: 1px solid #fecaca;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    display: flex; align-items: center; gap: 7px;
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-delete:hover { background: #fef2f2; border-color: var(--danger); }

  /* ── Amenities ── */
  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
    margin-bottom: 1rem;
  }
  .amenity-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 13px;
    color: var(--text);
    transition: border-color 0.2s, background 0.2s;
  }
  .amenity-chip:hover { border-color: var(--accent); background: #f0fdf8; }
  .amenity-chip i { color: var(--accent); font-size: 16px; }

  /* ── Review Form ── */
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .review-form-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .form-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .form-control {
    border-radius: 10px !important;
    border: 1px solid var(--border) !important;
    font-size: 14px !important;
    font-family: 'DM Sans', sans-serif;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-control:focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 3px rgba(29,158,117,0.1) !important;
    outline: none;
  }
  .btn-submit-review {
    padding: 11px 28px;
    background: var(--text);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  .btn-submit-review:hover { background: #1f2937; }
  .btn-submit-review:active { transform: scale(0.98); }

  /* ── Review Cards ── */
  .review-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    margin-bottom: 1.5rem;
  }
  .review-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: box-shadow 0.2s;
  }
  .review-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); }
  .reviewer-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .reviewer-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1D9E75, #0F6E56);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
    text-transform: uppercase;
  }
  .reviewer-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }
  .review-comment {
    font-size: 13px;
    color: #374151;
    line-height: 1.65;
  }
  .btn-del-review {
    align-self: flex-start;
    padding: 5px 12px;
    background: #fff;
    color: var(--danger);
    border: 1px solid #fecaca;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
    font-family: 'DM Sans', sans-serif;
  }
  .btn-del-review:hover { background: #fef2f2; }

  /* ── Add-on Services ── */
  .addon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .addon-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 16px 12px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    text-align: center;
    transition: border-color 0.2s, background 0.2s;
  }
  .addon-chip:hover { border-color: var(--accent); background: #f0fdf8; }
  .addon-chip i { font-size: 22px; color: var(--accent); }

  /* ── Divider ── */
  .fancy-divider {
    display: flex; align-items: center; gap: 14px;
    margin: 2rem 0;
  }
  .fancy-divider::before, .fancy-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--border);
  }
  .fancy-divider span {
    font-size: 12px; color: var(--muted); white-space: nowrap;
  }

  /* ── Animations ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fade-up { animation: fadeUp 0.5s ease both; }
  .delay-1 { animation-delay: 0.08s; }
  .delay-2 { animation-delay: 0.16s; }
  .delay-3 { animation-delay: 0.24s; }
  .delay-4 { animation-delay: 0.32s; }
</style>

<body>
  <div class="container py-4" style="max-width: 860px;">

    <!-- ── Hero Image ── -->
    <div class="show-hero fade-up">
      <img src="<%= listing.image && listing.image.url ? listing.image.url : '/default.png' %>" alt="listing-img">
      <div class="hero-badge">
        <i class="fa-solid fa-tag" style="font-size:11px;"></i>
        <%= listing.category %>
      </div>
      <div class="hero-price">
        <span class="amount">&#8377;<%= listing.price ? listing.price.toLocaleString("en-In") : "N/A" %></span>
        <span class="per">per night</span>
      </div>
    </div>

    <!-- ── Title & Meta ── -->
    <div class="fade-up delay-1">
      <h1 class="listing-title"><%= listing.title %></h1>
      <div class="listing-meta">
        <span class="meta-item">
          <i class="fa-solid fa-location-dot"></i>
          <span><b><%= listing.location %></b>, <%= listing.country %></span>
        </span>
        <span class="meta-item">
          <i class="fa-solid fa-user"></i>
          <span>Hosted by <b><%= listing.owner ? listing.owner.username : "Unknown" %></b></span>
        </span>
        <span class="meta-item">
          <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
          <span><b><%= listing.reviews.length %></b> review<%= listing.reviews.length !== 1 ? 's' : '' %></span>
        </span>
      </div>
    </div>

    <!-- ── Description ── -->
    <div class="info-card fade-up delay-2">
      <h5>About this place</h5>
      <p><%= listing.description %></p>
    </div>

    <!-- ── Action Buttons ── -->
    <div class="action-strip fade-up delay-2">
      <form action="/listings/<%= listing._id %>/reservelisting" method="GET" style="flex:1; min-width:160px;">
        <button type="submit" class="btn-reserve" style="width:100%;">
          <i class="fa-solid fa-calendar-check"></i> Reserve Now
        </button>
      </form>
      <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)){ %>
        <a href="/listings/<%= listing._id %>/edit" class="btn-edit">
          <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
          <button type="submit" class="btn-delete">
            <i class="fa-solid fa-trash"></i> Delete
          </button>
        </form>
      <% } %>
    </div>

    <div class="fancy-divider"><span>amenities</span></div>

    <!-- ── Amenities ── -->
    <div class="fade-up delay-3">
      <h4 class="section-title">What this place offers</h4>
      <div class="amenity-grid">
        <div class="amenity-chip"><i class="ri-restaurant-line"></i> Kitchen</div>
        <div class="amenity-chip"><i class="ri-car-fill"></i> Parking</div>
        <div class="amenity-chip"><i class="ri-t-shirt-air-fill"></i> Air conditioning</div>
        <div class="amenity-chip"><i class="ri-tv-2-line"></i> TV</div>
        <div class="amenity-chip"><i class="ri-vidicon-line"></i> Security cameras</div>
        <div class="amenity-chip"><i class="ri-wifi-line"></i> Wifi</div>
      </div>
      <div class="mt-3 mb-1">
        <button type="button" class="btn-edit" data-bs-toggle="modal" data-bs-target="#amenitiesModal"
          style="border-radius:10px; padding:10px 18px;">
          <i class="fa-solid fa-list"></i> Show all amenities
        </button>
      </div>
    </div>

    <!-- Amenities Modal -->
    <div class="modal fade" id="amenitiesModal" tabindex="-1" aria-labelledby="amenitiesModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:16px; border:1px solid var(--border);">
          <div class="modal-header" style="border-bottom:1px solid var(--border);">
            <h5 class="modal-title" style="font-family:'Playfair Display',serif; font-weight:700;" id="amenitiesModalLabel">
              What this place offers
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" style="font-size:14px; color:#374151;">
            <b style="font-size:15px;">Scenic views</b>
            <ul class="mt-1 mb-3"><li>Lake view</li><li>Mountain view</li><li>Pool view</li></ul>
            <b style="font-size:15px;">Bathrooms</b>
            <ul class="mt-1 mb-3"><li>Cleaning products</li><li>Shampoo</li><li>Hot Water</li></ul>
            <b style="font-size:15px;">Bedroom & Laundry</b>
            <ul class="mt-1 mb-3"><li>Essentials</li><li>Hangers</li><li>Bed linen</li></ul>
            <b style="font-size:15px;">Entertainment</b>
            <ul class="mt-1 mb-3"><li>TV with standard cable/satellite</li><li>Sound system with Bluetooth and aux</li><li>Pool table</li></ul>
            <b style="font-size:15px;">Outdoor</b>
            <ul class="mt-1 mb-3"><li>Patio or balcony</li><li>Garden</li><li>Hammock</li><li>Firepit</li><li>BBQ grill</li></ul>
            <b style="font-size:15px;">Kitchen & Dining</b>
            <ul class="mt-1 mb-3"><li>Dishes and cutlery</li><li>Barbecue utensils</li><li>Dining table</li><li>Freezer</li></ul>
            <b style="font-size:15px;">Location Features</b>
            <ul class="mt-1 mb-3">
              <li>Waterfront — Right next to a body of water</li>
              <li>Lake access — Guests can get to a lake using a path or dock</li>
              <li>Private entrance — Separate street or building entrance</li>
            </ul>
            <p style="color:var(--muted); font-size:13px;">...and many more</p>
          </div>
          <div class="modal-footer" style="border-top:1px solid var(--border); justify-content:center;">
            <button type="button" class="btn-delete" data-bs-dismiss="modal" style="border-radius:10px;">Close</button>
          </div>
        </div>
      </div>
    </div>

    <div class="fancy-divider"><span>add-on services</span></div>

    <!-- ── Add-on Services ── -->
    <div class="fade-up delay-3">
      <h4 class="section-title">Add-on services</h4>
      <p style="font-size:14px; color:var(--muted); margin-bottom:1rem;">
        After booking, a trip designer can arrange any of these services.
      </p>
      <div class="addon-grid">
        <div class="addon-chip"><i class="ri-flight-takeoff-fill"></i> Airport Transfer</div>
        <div class="addon-chip"><i class="ri-goblet-line"></i> Butler</div>
        <div class="addon-chip"><i class="ri-luggage-cart-fill"></i> Pre-stocking</div>
        <div class="addon-chip"><i class="ri-hand-sanitizer-fill"></i> Cleaning</div>
      </div>
    </div>

    <% if(currUser){ %>
      <div class="fancy-divider"><span>leave a review</span></div>

      <!-- ── Review Form ── -->
      <div class="fade-up delay-4">
        <h4 class="section-title">Leave a Review</h4>
        <div class="review-form-card">
          <form class="needs-validation" novalidate
            action="/listings/<%= listing._id %>/reviews" method="POST">
            <div class="mb-3">
              <label class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" /><label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" /><label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" /><label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" /><label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" /><label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label class="form-label" for="comment">Your thoughts</label>
              <textarea class="form-control" name="review[comment]" id="comment" rows="4"
                placeholder="Share your experience with this place..." required></textarea>
              <div class="invalid-feedback">Please add some comments for review</div>
            </div>
            <button type="submit" class="btn-submit-review">
              <i class="fa-solid fa-paper-plane" style="margin-right:6px;"></i>Submit Review
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <% if(listing.reviews.length > 0){ %>
      <div class="fancy-divider"><span>all reviews</span></div>

      <!-- ── Reviews Grid ── -->
      <div class="fade-up delay-4">
        <h4 class="section-title">All Reviews</h4>
        <div class="review-grid">
          <% for (let review of listing.reviews) { %>
            <div class="review-card">
              <div class="reviewer-row">
                <div class="reviewer-avatar">
                  <%= review.author ? review.author.username.charAt(0) : "?" %>
                </div>
                <div>
                  <div class="reviewer-name">
                    <%= review.author ? review.author.username : "Unknown" %>
                  </div>
                  <p class="starability-result" data-rating="<%= review.rating %>" style="margin:0;"></p>
                </div>
              </div>
              <p class="review-comment"><%= review.comment %></p>
              <% if(currUser && review.author && currUser._id.equals(review.author._id)){ %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                  <button type="submit" class="btn-del-review">
                    <i class="fa-solid fa-trash" style="font-size:11px;"></i> Delete
                  </button>
                </form>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</body>
