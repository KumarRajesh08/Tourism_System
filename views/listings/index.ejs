<% layout("/layouts/boilerplate") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --accent: #1D9E75;
    --accent-dark: #0F6E56;
    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;
    --bg: #f9fafb;
    --card: #ffffff;
  }

  body { background: var(--bg); font-family: 'DM Sans', sans-serif; }

  /* ── Filter Bar ── */
  #filter-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 12px 0 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2rem;
  }

  .scroll-btn {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    font-size: 11px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
    z-index: 2;
  }
  .scroll-btn:hover { border-color: var(--accent); background: #f0fdf8; color: var(--accent); }

  #filters-container { flex: 1; overflow: hidden; }

  #filters {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 0;
    user-select: none;
  }
  #filters::-webkit-scrollbar { display: none; }

  .filter a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 9px 16px;
    border-radius: 50px;
    border: 1px solid var(--border);
    background: var(--card);
    text-decoration: none;
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .filter a i { font-size: 16px; }
  .filter a:hover { border-color: var(--accent); background: #f0fdf8; color: var(--accent-dark); }
  .filter.active a { border-color: var(--accent); background: var(--accent); color: #fff; }

  /* ── Tax Toggle ── */
  .tax-toggle {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 50px;
    background: var(--card);
  }
  .tax-toggle .form-check-label { font-size: 12px; font-weight: 600; cursor: pointer; }

  /* ── Listings Grid ── */
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding-bottom: 3rem;
  }

  .listing-link { text-decoration: none; animation: fadeUp 0.4s ease both; }

  .listing-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.25s;
  }
  .listing-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }

  .card-img-wrap { position: relative; height: 220px; overflow: hidden; }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .listing-card:hover .card-img-wrap img { transform: scale(1.05); }

  .card-category-badge {
    position: absolute; top: 12px; left: 12px;
    background: rgba(255,255,255,0.9); backdrop-filter: blur(4px);
    border-radius: 50px; padding: 4px 10px; font-size: 11px; font-weight: 600; color: var(--accent-dark);
  }

  .wishlist-btn {
    position: absolute; top: 10px; right: 10px;
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(255,255,255,0.9); border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; color: var(--muted);
  }

  .listing-card-body { padding: 16px; }
  .listing-title { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
  
  .listing-price { font-size: 14px; font-weight: 600; color: var(--text); }
  .listing-price .muted-text { font-size: 12px; font-weight: 400; color: var(--muted); }

  .tax-info-badge {
    font-size: 10px; font-weight: 700; color: var(--accent);
    background: #f0fdf8; padding: 2px 8px; border-radius: 4px;
    display: none; margin-left: 8px;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<body>
  <div id="filter-wrapper">
    <button class="scroll-btn left-btn"><i class="fa-solid fa-chevron-left"></i></button>

    <div id="filters-container">
      <div id="filters">

        <%
          const categories = [
            { value: "Rooms",             icon: "fa-solid fa-bed",                  label: "Rooms" },
            { value: "Iconic-Cities",     icon: "fa-solid fa-mountain-city",        label: "Iconic Cities" },
            { value: "Trending",          icon: "fa-solid fa-fire",                 label: "Trending" },
            { value: "Mountains",         icon: "fa-solid fa-mountain-sun",         label: "Mountains" },
            { value: "Castles",           icon: "fa-brands fa-fort-awesome",        label: "Castles" },
            { value: "Amazing-Pools",     icon: "fa-solid fa-person-swimming",      label: "Amazing Pools" },
            { value: "Camping",           icon: "fa-solid fa-campground",           label: "Camping" },
            { value: "Farm",              icon: "fa-solid fa-cow",                  label: "Farm" },
            { value: "Arctic",            icon: "fa-solid fa-snowflake",            label: "Arctic" },
            { value: "Beach",             icon: "fa-solid fa-umbrella-beach",       label: "Beach" },
            { value: "Boat",              icon: "fa-solid fa-sailboat",             label: "Boat" },
            { value: "Ski-in-out",        icon: "fa-solid fa-person-snowboarding", label: "Ski-in/out" },
            { value: "Apartment",         icon: "fa-solid fa-building",             label: "Apartment" },
            { value: "New",               icon: "fa-solid fa-key",                  label: "New" },
            { value: "Woodlands",         icon: "fa-solid fa-tree-city",            label: "Woodlands" },
            { value: "Lake",              icon: "fa-solid fa-water",                label: "Lake" },
            { value: "Cabins",            icon: "fa-solid fa-house",                label: "Cabins" },
            { value: "Countryside",       icon: "fa-solid fa-house-chimney-window", label: "Countryside" },
            { value: "Bed-and-Breakfasts",icon: "fa-solid fa-mug-hot",             label: "Bed & Breakfasts" },
            { value: "Campsite",          icon: "fa-solid fa-tents",                label: "Campsite" },
            { value: "Historical-Homes",  icon: "fa-solid fa-landmark",             label: "Historical Homes" },
          ];
        %>

        <% for(let cat of categories) { %>
          <div class="filter">
            <a href="/listings/filter/<%= cat.value %>">
              <i class="<%= cat.icon %>"></i>
              <p><%= cat.label %></p>
            </a>
          </div>
        <% } %>

      </div>
    </div>

    <button class="scroll-btn right-btn"><i class="fa-solid fa-chevron-right"></i></button>

    <div class="tax-toggle">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" id="taxToggle">
        <label class="form-check-label" for="taxToggle">Display Total</label>
      </div>
    </div>
  </div>

  <div class="container-fluid px-4">
    <div class="listings-grid">
      <% if(allListings.length === 0) { %>
        <div class="empty-state">
          <i class="fa-solid fa-magnifying-glass"></i>
          <h4>No results found</h4>
        </div>
      <% } %>

      <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="listing-card">
            <div class="card-img-wrap">
              <img src="<%= listing.image && listing.image.url ? listing.image.url : '/default.png' %>" alt="listing">
              <% if(listing.category) { %><span class="card-category-badge"><%= listing.category %></span><% } %>
              <button class="wishlist-btn" onclick="event.preventDefault(); toggleWishlist(this)">
                <i class="fa-regular fa-heart"></i>
              </button>
            </div>
            <div class="listing-card-body">
              <div class="listing-title"><%= listing.title %></div>
              <div class="listing-price">
                &#8377;<span class="price-amount"
                             data-base="<%= listing.price %>"
                             data-gst="<%= listing.price ? Math.round(listing.price * 1.18) : 0 %>">
                  <%= listing.price ? listing.price.toLocaleString("en-In") : "0" %>
                </span>
                <span class="muted-text">/ night</span>
                <span class="tax-info-badge">INC. GST</span>
              </div>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  </div>

  <script>
    // ── Horizontal Scroll ──
    const filters = document.getElementById('filters');
    document.querySelector('.left-btn').onclick = () => filters.scrollBy({ left: -300, behavior: 'smooth' });
    document.querySelector('.right-btn').onclick = () => filters.scrollBy({ left: 300, behavior: 'smooth' });

    // ── Tax Logic ──
    const taxToggle = document.getElementById('taxToggle');
    taxToggle.addEventListener('change', function() {
      const isTaxed = this.checked;
      document.querySelectorAll('.price-amount').forEach(el => {
        const val = isTaxed ? el.dataset.gst : el.dataset.base;
        el.innerText = Number(val).toLocaleString('en-In');
      });
      document.querySelectorAll('.tax-info-badge').forEach(badge => {
        badge.style.display = isTaxed ? 'inline-block' : 'none';
      });
    });

    // ── Wishlist UI ──
    function toggleWishlist(btn) {
      const icon = btn.querySelector('i');
      const isSolid = icon.classList.toggle('fa-solid');
      icon.classList.toggle('fa-regular', !isSolid);
      icon.style.color = isSolid ? '#ef4444' : '';
    }
  </script>
</body>
