<% layout("/layouts/boilerplate") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --accent: #1D9E75;
    --accent-dark: #0F6E56;
    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;
    --bg: #f9fafb;
    --card: #ffffff;
  }

  body { background: var(--bg); font-family: 'DM Sans', sans-serif; }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.3rem;
  }
  .page-header p { font-size: 14px; color: var(--muted); }

  .form-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2.5rem;
    max-width: 720px;
    margin: 0 auto;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .form-section { margin-bottom: 2rem; }

  .section-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px; background: var(--border);
  }

  .form-label {
    font-size: 13px;
    font-weight: 500;
    color: #374151;
    margin-bottom: 6px;
    display: block;
  }

  .form-control {
    border-radius: 10px !important;
    border: 1px solid var(--border) !important;
    font-size: 14px !important;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    background: var(--bg);
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .form-control:focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 3px rgba(29,158,117,0.1) !important;
    background: #fff !important;
    outline: none;
  }
  .form-control.is-invalid { border-color: #ef4444 !important; }
  .invalid-feedback { font-size: 12px; color: #ef4444; margin-top: 4px; }
  .valid-feedback   { font-size: 12px; color: var(--accent); margin-top: 4px; }

  /* ── Current Image Preview ── */
  .img-preview-wrap {
    position: relative;
    display: inline-block;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    max-width: 100%;
  }
  .img-preview-wrap img {
    width: 100%;
    max-height: 220px;
    object-fit: cover;
    display: block;
  }
  .img-preview-badge {
    position: absolute;
    bottom: 10px; left: 10px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 50px;
  }

  /* ── Upload Zone ── */
  .upload-zone {
    border: 2px dashed var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    background: var(--bg);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }
  .upload-zone:hover { border-color: var(--accent); background: #f0fdf8; }
  .upload-zone input[type="file"] {
    position: absolute; inset: 0;
    opacity: 0; cursor: pointer; width: 100%; height: 100%;
  }
  .upload-zone i { font-size: 24px; color: var(--accent); margin-bottom: 6px; display: block; }
  .upload-zone .upload-text { font-size: 13px; font-weight: 500; color: var(--text); }
  .upload-zone .upload-sub  { font-size: 12px; color: var(--muted); margin-top: 2px; }
  #file-name { font-size: 12px; color: var(--accent); margin-top: 6px; font-weight: 500; }

  /* ── Category Grid ── */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
    gap: 10px;
  }
  .cat-option { display: none; }
  .cat-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 13px 10px;
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    background: var(--bg);
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    text-align: center;
    user-select: none;
  }
  .cat-label i { font-size: 18px; color: var(--muted); transition: color 0.2s; }
  .cat-label:hover { border-color: var(--accent); background: #f0fdf8; }
  .cat-label:hover i { color: var(--accent); }
  .cat-option:checked + .cat-label {
    border-color: var(--accent);
    background: #f0fdf8;
    color: var(--accent-dark);
    font-weight: 600;
  }
  .cat-option:checked + .cat-label i { color: var(--accent); }

  /* ── Price prefix ── */
  .price-wrap { position: relative; }
  .price-prefix {
    position: absolute;
    left: 14px; top: 50%;
    transform: translateY(-50%);
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    pointer-events: none;
  }
  .price-wrap .form-control { padding-left: 30px !important; }

  /* ── Three col ── */
  .three-col {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 16px;
  }
  @media (max-width: 540px) { .three-col { grid-template-columns: 1fr; } }

  /* ── Buttons ── */
  .btn-row {
    display: flex;
    gap: 12px;
    margin-top: 1.5rem;
  }
  .btn-save {
    flex: 1;
    padding: 13px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-save:hover  { background: var(--accent-dark); }
  .btn-save:active { transform: scale(0.99); }
  .btn-cancel {
    padding: 13px 22px;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none;
    display: flex; align-items: center; gap: 7px;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-cancel:hover { border-color: #9ca3af; background: var(--bg); color: var(--text); }

  /* ── Animations ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fade-up  { animation: fadeUp 0.45s ease both; }
  .delay-1  { animation-delay: 0.06s; }
  .delay-2  { animation-delay: 0.12s; }
  .delay-3  { animation-delay: 0.18s; }
</style>

<body>
  <div class="container py-5">

    <!-- ── Page Header ── -->
    <div class="page-header fade-up">
      <h1>Edit Listing</h1>
      <p>Update your property details below</p>
    </div>

    <div class="form-card fade-up delay-1">
      <form action="/listings/<%= listing._id %>?_method=PUT" method="post" novalidate
        class="needs-validation" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">


        <!-- ── Basic Info ── -->
        <div class="form-section">
          <div class="section-label"><i class="fa-solid fa-pen-nib"></i> Basic Info</div>

          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" class="form-control" id="title"
              placeholder="Give your listing a catchy title" required
              value="<%= listing.title %>">
            <div class="valid-feedback">Title looks good!</div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" id="description"
              rows="5" placeholder="Describe what makes this place special..." required
            ><%= listing.description %></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
          </div>
        </div>

        <!-- ── Images ── -->
        <div class="form-section fade-up delay-2">
          <div class="section-label"><i class="fa-solid fa-image"></i> Images</div>

          <label class="form-label">Current Image</label>
          <div class="img-preview-wrap mb-3">
            <img src="<%= imageUrl %>" alt="Current listing image">
            <span class="img-preview-badge"><i class="fa-solid fa-image" style="font-size:10px; margin-right:4px;"></i>Current</span>
          </div>

          <label class="form-label">Upload New Image <span style="color:var(--muted); font-weight:400;">(optional)</span></label>
          <div class="upload-zone" id="uploadZone">
            <input type="file" name="listing[image]" id="image" accept="image/*"
              onchange="showFileName(this)">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <div class="upload-text">Click or drag to replace image</div>
            <div class="upload-sub">PNG, JPG, WEBP supported</div>
            <div id="file-name"></div>
          </div>
        </div>

        <!-- ── Category ── -->
        <div class="form-section fade-up delay-2">
          <div class="section-label"><i class="fa-solid fa-tag"></i> Category</div>

          <% const categories = [
            { id: "rooms",              value: "Rooms",              icon: "fa-solid fa-bed",                   label: "Rooms" },
            { id: "iconic-cities",      value: "Iconic-Cities",      icon: "fa-solid fa-mountain-city",         label: "Iconic Cities" },
            { id: "mountains",          value: "Mountains",          icon: "fa-solid fa-mountain-sun",          label: "Mountains" },
            { id: "castles",            value: "Castles",            icon: "fa-brands fa-fort-awesome",         label: "Castles" },
            { id: "boat",               value: "Boat",               icon: "fa-solid fa-sailboat",              label: "Boat" },
            { id: "ski-in-out",         value: "Ski-in-out",         icon: "fa-solid fa-person-snowboarding",   label: "Ski-in/out" },
            { id: "apartment",          value: "Apartment",          icon: "fa-solid fa-building",              label: "Apartment" },
            { id: "new",                value: "New",                icon: "fa-solid fa-key",                   label: "New" },
            { id: "woodlands",          value: "Woodlands",          icon: "fa-solid fa-tree-city",             label: "Woodlands" },
            { id: "lake",               value: "Lake",               icon: "fa-solid fa-water",                 label: "Lake" },
            { id: "amazing-pools",      value: "Amazing-Pools",      icon: "fa-solid fa-person-swimming",       label: "Amazing Pools" },
            { id: "cabins",             value: "Cabins",             icon: "fa-solid fa-house",                 label: "Cabins" },
            { id: "camping",            value: "Camping",            icon: "fa-solid fa-campground",            label: "Camping" },
            { id: "farm",               value: "Farm",               icon: "fa-solid fa-cow",                   label: "Farm" },
            { id: "arctic",             value: "Arctic",             icon: "fa-solid fa-snowflake",             label: "Arctic" },
            { id: "beach",              value: "Beach",              icon: "fa-solid fa-umbrella-beach",        label: "Beach" },
            { id: "countryside",        value: "Countryside",        icon: "fa-solid fa-house-chimney-window",  label: "Countryside" },
            { id: "bed-and-breakfasts", value: "Bed-and-Breakfasts", icon: "fa-solid fa-mug-hot",              label: "Bed & Breakfasts" },
            { id: "campsite",           value: "Campsite",           icon: "fa-solid fa-tents",                 label: "Campsite" },
            { id: "historical-homes",   value: "Historical-Homes",   icon: "fa-solid fa-landmark",              label: "Historical Homes" },
          ]; %>

          <div class="category-grid">
            <% for(let cat of categories) { %>
              <div>
                <input class="cat-option" type="radio"
                  id="<%= cat.id %>"
                  name="listing[category]"
                  value="<%= cat.value %>"
                  required
                  <%= listing.category === cat.value ? 'checked' : '' %>
                >
                <label class="cat-label" for="<%= cat.id %>">
                  <i class="<%= cat.icon %>"></i>
                  <%= cat.label %>
                </label>
              </div>
            <% } %>
          </div>
          <div class="invalid-feedback" style="margin-top:8px;">Please choose a category</div>
        </div>

        <!-- ── Price & Location ── -->
        <div class="form-section fade-up delay-3">
          <div class="section-label"><i class="fa-solid fa-location-dot"></i> Price & Location</div>

          <div class="three-col mb-3">
            <div>
              <label for="price" class="form-label">Price / night (₹)</label>
              <div class="price-wrap">
                <span class="price-prefix">₹</span>
                <input type="number" class="form-control" name="listing[price]" id="price"
                  placeholder="0" min="0" required value="<%= listing.price %>">
              </div>
              <div class="invalid-feedback">Enter a valid price</div>
            </div>
            <div>
              <label for="location" class="form-label">Location</label>
              <input type="text" name="listing[location]" class="form-control" id="location"
                placeholder="City, Area..." required value="<%= listing.location %>">
              <div class="invalid-feedback">Location is required</div>
            </div>
          </div>

          <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" class="form-control" id="country"
              placeholder="e.g. India" required value="<%= listing.country %>">
            <div class="invalid-feedback">Country is required</div>
          </div>
        </div>

        <!-- ── Action Buttons ── -->
        <div class="btn-row">
          <a href="/listings/<%= listing._id %>" class="btn-cancel">
            <i class="fa-solid fa-xmark"></i> Cancel
          </a>
          <button type="submit" class="btn-save">
            <i class="fa-solid fa-floppy-disk"></i> Save Changes
          </button>
        </div>

      </form>
    </div>
  </div>
</body>

<script>
  function showFileName(input) {
    const name = input.files[0] ? input.files[0].name : '';
    document.getElementById('file-name').textContent = name ? '✓ ' + name : '';
  }

  // Bootstrap validation
  (function () {
    const forms = document.querySelectorAll('.needs-validation');
    forms.forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    });
  })();
</script>
