<% layout("/layouts/boilerplate.ejs") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --accent: #1D9E75;
    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;
    --bg: #f9fafb;
    --card: #ffffff;
    --danger: #ef4444;
    --danger-bg: #fef2f2;
    --danger-border: #fecaca;
  }

  body { background: var(--bg); font-family: 'DM Sans', sans-serif; }

  .error-wrapper {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .error-card {
    background: var(--card);
    border: 1px solid var(--danger-border);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    max-width: 500px;
    width: 100%;
    text-align: center;
    box-shadow: 0 4px 32px rgba(239,68,68,0.08);
    animation: fadeUp 0.45s ease both;
  }

  .error-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--danger-bg);
    border: 1px solid var(--danger-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .error-icon-wrap i {
    font-size: 28px;
    color: var(--danger);
  }

  .error-code {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--danger);
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.8rem;
  }

  .error-message {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    background: var(--danger-bg);
    border: 1px solid var(--danger-border);
    border-radius: 10px;
    padding: 12px 16px;
    color: #b91c1c;
    font-weight: 500;
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none;
    transition: background 0.2s, transform 0.1s;
  }
  .btn-home:hover  { background: #0F6E56; color: #fff; }
  .btn-home:active { transform: scale(0.98); }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    text-decoration: none;
    margin-right: 10px;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-back:hover { border-color: #9ca3af; background: var(--bg); color: var(--text); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="error-wrapper">
  <div class="error-card">

    <div class="error-icon-wrap">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <div class="error-code">Error</div>

    <h1 class="error-title">Something went wrong</h1>

    <div class="error-message">
      <%= message %>
    </div>

    <div>
      <a href="javascript:history.back()" class="btn-back">
        <i class="fa-solid fa-arrow-left"></i> Go Back
      </a>
      <a href="/listings" class="btn-home">
        <i class="fa-solid fa-house"></i> Go Home
      </a>
    </div>

  </div>
</div>
