<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <h1 class="mb-4">Admin Panel</h1>

  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card p-3">
        <h3>Users</h3>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td><%= user.role %></td>
                <td>
                  <form action="/admin/users/<%= user._id %>/toggle-role" method="post" style="display:inline">
                    <button class="btn btn-sm btn-secondary" type="submit"><%= user.role === 'admin' ? 'Demote' : 'Promote' %></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card p-3">
        <h3>Listings</h3>
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Title</th>
              <th>Owner</th>
              <th>Price</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% listings.forEach((listing) => { %>
              <tr>
                <td><a href="/listings/<%= listing._id %>"><%= listing.title %></a></td>
                <td><%= listing.owner?.username || 'N/A' %></td>
                <td>₹<%= listing.price %></td>
                <td>
                  <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="post" style="display:inline">
                    <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
